MONGO_URL=mongodb://localhost:27017
DB_NAME=ghostel
JWT_SECRET=replace-with-a-long-random-secret
APP_NAME=Ghostel
ALLOW_LEGACY_WS_TOKEN=true

ADMIN_EMAIL=admin@ghostel.app
ADMIN_PASSWORD=replace-with-a-strong-password
DEMO_EMAIL=demo@silentel.app
DEMO_PASSWORD=replace-with-a-strong-password

# Comma-separated list for web deployments, for example:
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# Prefer this env var in production. Do not commit the real JSON file.
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FCM_SERVICE_ACCOUNT_PATH=/secure/path/firebase-service-account.json

# Production WebRTC relay. Required for reliable calls between different
# mobile networks/NATs. Separate multiple URLs with commas.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# TURN_USERNAME=ghostel
# TURN_CREDENTIAL=replace-with-a-strong-turn-password

# Alternative: Cloudflare Calls TURN with short-lived credentials.
# CLOUDFLARE_TURN_APP_ID=
# CLOUDFLARE_TURN_API_TOKEN=
