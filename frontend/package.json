{
  "name": "ghostel",
  "productName": "ghostel.app",
  "description": "ghostel.app private messaging desktop client",
  "author": {
    "name": "ghostel.app",
    "email": "support@ghostel.app"
  },
  "main": "./index.js",
  "version": "1.4.30",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:build": "expo export --platform web --output-dir dist-web --clear",
    "web:serve": "python serve_static.py --host 127.0.0.1 --port 19006 --directory dist-web",
    "desktop": "electron desktop/main.cjs",
    "desktop:build:web": "expo export --platform web --output-dir dist-web --clear",
    "desktop:pack": "yarn desktop:build:web && electron-builder --dir",
    "desktop:build": "yarn desktop:build:web && electron-builder --win nsis",
    "lint": "expo lint",
    "postinstall": "node ./scripts/patch-webrtc.js && node ./scripts/patch-callkeep.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.20.6",
    "@config-plugins/react-native-webrtc": "^14.0.0",
    "@expo/metro-runtime": "^6.1.2",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/messaging": "^24.0.0",
    "@react-navigation/bottom-tabs": "7.16.2",
    "@react-navigation/elements": "2.9.19",
    "@react-navigation/native": "7.2.5",
    "@react-navigation/native-stack": "7.16.0",
    "axios": "^1.16.0",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-screen-capture": "~8.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "i18next": "^26.3.0",
    "lucide-react-native": "^1.14.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.81.5",
    "react-native-callkeep": "^4.3.16",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-incall-manager": "^4.2.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-voip-push-notification": "3.3.3",
    "react-native-web": "^0.21.0",
    "react-native-webrtc": "^124.0.7",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "20.1.3",
    "@types/react": "~19.1.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-navigation/bottom-tabs",
        "@react-navigation/native",
        "@react-navigation/native-stack"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-webrtc",
          "react-native-callkeep",
          "react-native-incall-manager"
        ],
        "listUnknownPackages": false
      },
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "resolutions": {
    "**/@react-navigation/native": "7.2.5",
    "**/postcss": "8.5.10",
    "**/uuid": "11.1.1"
  },
  "build": {
    "appId": "app.ghostel.desktop",
    "productName": "ghostel.app",
    "copyright": "Copyright © 2026 ghostel.app",
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "desktop/**/*",
      "dist-web/**/*",
      "assets/images/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/images/icon.png",
      "artifactName": "Ghostel-Desktop-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ghostel.app",
      "deleteAppDataOnUninstall": false
    }
  },
  "private": true,
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
