server {
    listen 80;
    server_name app.ghostel.app;

    root /var/www/ghostel-web-app;
    index index.html;

    location = /sw.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location /_expo/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri.html /index.html;
    }
}
