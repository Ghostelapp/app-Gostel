{
  "expo": {
    "name": "ghostel.app",
    "slug": "ghostel",
    "version": "1.4.16",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ghostel",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.ghostel",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Record voice messages",
        "NSCameraUsageDescription": "Share photos in chats",
        "NSPhotoLibraryUsageDescription": "Send photos from your library"
      }
    },
    "android": {
      "package": "app.ghostel",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0f1419"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "USE_FULL_SCREEN_INTENT",
        "VIBRATE",
        "WAKE_LOCK",
        "TURN_SCREEN_ON",
        "DISABLE_KEYGUARD"
      ],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 17
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f1419"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-audio",
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#00d9ff",
          "sounds": [
            "./assets/audio/ringtone.wav",
            "./assets/audio/message.wav",
            "./assets/audio/notification.wav"
          ]
        }
      ],
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#0f1419",
          "barStyle": "light"
        }
      ],
      "@config-plugins/react-native-webrtc",
      "./plugins/withWebRtcEventTargetShimFix",
      "./plugins/withWakeScreenAndroidActivity",
      "expo-localization",
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "./plugins/withFirebaseManifestFix"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "42a94967-dd0a-4630-b20d-9fe64bc91934"
      }
    },
    "owner": "coda666"
  }
}
