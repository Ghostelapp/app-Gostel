{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "node": "22.13.0",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.ghostel.app"
      }
    },
    "preview": {
      "node": "22.13.0",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.ghostel.app"
      }
    },
    "ios-simulator": {
      "node": "22.13.0",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_SKIP_FIREBASE_IOS": "1",
        "EXPO_USE_COMMUNITY_AUTOLINKING": "1",
        "EXPO_USE_JSC_IOS": "1",
        "EXPO_PUBLIC_BACKEND_URL": "https://api.ghostel.app"
      }
    },
    "ios-production": {
      "extends": "production",
      "env": {
        "EXPO_SKIP_FIREBASE_IOS": "1",
        "EXPO_USE_COMMUNITY_AUTOLINKING": "1",
        "EXPO_USE_JSC_IOS": "1",
        "EXPO_PUBLIC_BACKEND_URL": "https://api.ghostel.app"
      }
    },
    "ios-production-firebase": {
      "extends": "production",
      "env": {
        "EXPO_REQUIRE_FIREBASE_IOS": "1",
        "EXPO_USE_COMMUNITY_AUTOLINKING": "1",
        "EXPO_USE_JSC_IOS": "1",
        "EXPO_PUBLIC_BACKEND_URL": "https://api.ghostel.app"
      }
    },
    "production": {
      "node": "22.13.0",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.ghostel.app"
      }
    },
    "ios-testflight": {
      "extends": "ios-production-firebase",
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_APP_VARIANT": "production",
        "EXPO_PUBLIC_MLS_SELF_TEST": "0",
        "EXPO_STAGING_NO_PUSH": "0",
        "EXPO_SKIP_FIREBASE_IOS": "0"
      }
    },
    "staging": {
      "node": "22.13.0",
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_STAGING_NO_PUSH": "1",
        "EXPO_USE_COMMUNITY_AUTOLINKING": "1",
        "EXPO_USE_JSC_IOS": "1",
        "EXPO_PUBLIC_APP_VARIANT": "staging"
      }
    },
    "staging-simulator": {
      "extends": "staging",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "http://127.0.0.1:18794"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6781015398"
      }
    },
    "ios-production-firebase": {
      "ios": {
        "ascAppId": "6781015398"
      }
    },
    "ios-testflight": {
      "ios": {
        "ascAppId": "6781015398"
      }
    }
  }
}
